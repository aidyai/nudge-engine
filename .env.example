# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# The website sends this key with every request. Use a long random string.
API_KEY=

# The models (see docs/deploy.md)
MODELS_API_KEY=
LLM_BASE_URL=
LLM_MODEL=phonellm-mini-alpha-2
TTS_URL=
DEEPGRAM_API_KEY=
HF_TOKEN=

# Phone calls (see docs/phone.md). Only the numbers listed here can ever be called.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALLOWED_NUMBERS=
