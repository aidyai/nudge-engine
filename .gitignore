# Secrets. Never commit these. (.env.example is the one that is allowed.)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
.modal.toml
credentials*.json
service-account*.json

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
dist/
build/
*.egg-info/

